cabal-version:      3.0
name:               fetch-gitlab
version:            0.1.1.0
synopsis:           Fetch all issues/MRs from a GitLab instance into SQLite
description:        Command line tool to dump GitLab issues and merge requests
                    into a SQLite database.
license:            BSD-3-Clause
author:             Andreas Klebinger
maintainer:         klebinger.andreas@gmx.at
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall -Wcompat -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  FetchGitLab.Options
                      FetchGitLab.ClearTimestamp
                      FetchGitLab.Logging
                      FetchGitLab.Lock
                      FetchGitLab.RateLimit
                      FetchGitLab.Since
                      FetchGitLab.Store
                      FetchGitLab.Store.Backend
                      FetchGitLab.Store.Class
                      FetchGitLab.Store.Schema
                      FetchGitLab.Store.Sqlite
                      FetchGitLab.Fetch
    -- For the version in the User-Agent header.
    other-modules:    Paths_fetch_gitlab
    autogen-modules:  Paths_fetch_gitlab
    build-depends:    base                 >=4.16 && <5
                    , aeson                >=2.0  && <2.3
                    , bytestring           >=0.11 && <0.13
                    , containers           >=0.6  && <0.9
                    , data-default         >=0.7  && <0.9
                    , directory            >=1.3  && <1.4
                    , filepath             >=1.4  && <1.6
                    , gitlab-haskell       >=1.4  && <1.5
                    , http-client          >=0.7  && <0.8
                    , http-client-tls      >=0.3  && <0.4
                    , http-types           >=0.12 && <0.13
                    , log-base             >=0.12 && <0.13
                    , mtl                  >=2.2  && <2.4
                    , optparse-applicative >=0.17 && <0.20
                    , process              >=1.6.3 && <1.7
                    , sqlite-simple        >=0.4.18 && <0.5
                    , text                 >=1.2  && <2.2
                    , time                 >=1.9  && <1.15
                    , vector               >=0.12 && <0.14
    default-language: Haskell2010

executable fetch-gitlab
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    -- A run holds one project's records and the discussion it is currently
    -- fetching, which is tens of megabytes. Anything approaching a gigabyte is
    -- a leak rather than a large project, and a heap overflow says so at the
    -- point it happens instead of the machine swapping. -rtsopts leaves the
    -- cap raisable from the command line if a project ever does need it.
    ghc-options:      -rtsopts "-with-rtsopts=-M1G"
    build-depends:    base
                    , fetch-gitlab
                    , optparse-applicative
    default-language: Haskell2010

test-suite fetch-gitlab-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    base
                    , aeson
                    , bytestring
                    , containers
                    , directory
                    , fetch-gitlab
                    , filepath             >=1.4  && <1.6
                    , gitlab-haskell
                    , http-client          >=0.7  && <0.8
                    , http-types           >=0.12 && <0.13
                    , process              >=1.6.3 && <1.7
                    , log-base
                    , tasty                >=1.4  && <1.6
                    , tasty-hunit          >=0.10 && <0.11
                    , temporary            >=1.3  && <1.4
                    , text
                    , time
    default-language: Haskell2010
