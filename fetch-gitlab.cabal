cabal-version:      3.0
name:               fetch-gitlab
version:            0.1.0.0
synopsis:           Fetch all issues/MRs from a GitLab instance as JSONL
description:        Command line tool to dump GitLab issues and merge requests
                    into newline delimited JSON files.
license:            BSD-3-Clause
author:             Andreas Klebinger
maintainer:         klebinger.andreas@gmx.at
build-type:         Simple
extra-doc-files:    README.md

common warnings
    ghc-options: -Wall -Wcompat -Wredundant-constraints

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:  FetchGitLab.Options
                      FetchGitLab.JsonLines
                      FetchGitLab.Lock
                      FetchGitLab.RateLimit
                      FetchGitLab.Since
                      FetchGitLab.Store
                      FetchGitLab.Fetch
    build-depends:    base                 >=4.16 && <5
                    , aeson                >=2.0  && <2.3
                    , bytestring           >=0.11 && <0.13
                    , containers           >=0.6  && <0.9
                    , data-default         >=0.7  && <0.9
                    , directory            >=1.3  && <1.4
                    , filepath             >=1.4  && <1.6
                    , gitlab-haskell       >=1.4  && <1.5
                    , http-client          >=0.7  && <0.8
                    , http-client-tls      >=0.3  && <0.4
                    , http-types           >=0.12 && <0.13
                    , log-base             >=0.12 && <0.13
                    , mtl                  >=2.2  && <2.4
                    , optparse-applicative >=0.17 && <0.20
                    , process              >=1.6.3 && <1.7
                    , text                 >=1.2  && <2.2
                    , time                 >=1.9  && <1.15
    default-language: Haskell2010

executable fetch-gitlab
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    build-depends:    base
                    , fetch-gitlab
                    , optparse-applicative
    default-language: Haskell2010

test-suite fetch-gitlab-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    build-depends:    base
                    , aeson
                    , bytestring
                    , containers
                    , directory
                    , fetch-gitlab
                    , filepath             >=1.4  && <1.6
                    , gitlab-haskell
                    , process              >=1.6.3 && <1.7
                    , tasty                >=1.4  && <1.6
                    , tasty-hunit          >=0.10 && <0.11
                    , temporary            >=1.3  && <1.4
                    , text
                    , time
    default-language: Haskell2010
